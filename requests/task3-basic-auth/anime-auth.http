@host = http://localhost:8080
@contentType = application/json
@username = animeadmin
@password = secret123

### 1. GET all anime products (authorized)
GET {{host}}/api/products
Accept: {{contentType}}
Authorization: Basic {{username}} {{password}}

> {%
    client.test("Status is 200 OK", () => {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
%}

### 2. Search anime products by franchise (authorized)
GET {{host}}/api/products?franchise=Naruto
Accept: {{contentType}}
Authorization: Basic {{username}} {{password}}

> {%
    client.test("Status is 200 OK", () => {
        client.assert(response.status === 200, "Expected 200");
    });
%}

### 3. Filter anime products by category (authorized)
GET {{host}}/api/products?category=FIGURE
Accept: {{contentType}}
Authorization: Basic {{username}} {{password}}

> {%
    client.test("Status is 200 OK", () => {
        client.assert(response.status === 200, "Expected 200");
    });
%}

### 4. CREATE a new anime product (authorized)
POST {{host}}/api/products
Content-Type: {{contentType}}
Authorization: Basic {{username}} {{password}}

{
  "title": "Gojo Satoru Hollow Purple Edition",
  "franchise": "Jujutsu Kaisen",
  "category": "FIGURE",
  "characterName": "Gojo Satoru",
  "price": 99.99,
  "stock": 10,
  "releaseYear": 2024,
  "rating": 5.0
}

> {%
    client.global.set("authCreatedId", response.body.id);
    client.test("Created successfully with 201", () => {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
        client.assert(response.body.id != null, "Expected product ID to be present");
    });
%}

### 5. GET the newly created product by ID (authorized)
GET {{host}}/api/products/{{authCreatedId}}
Accept: {{contentType}}
Authorization: Basic {{username}} {{password}}

> {%
    client.test("Status is 200 and matches product", () => {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.characterName === "Gojo Satoru", "Expected correct character name");
    });
%}

### 6. UPDATE product price and stock (authorized)
PUT {{host}}/api/products/{{authCreatedId}}
Content-Type: {{contentType}}
Authorization: Basic {{username}} {{password}}

{
  "title": "Gojo Satoru Hollow Purple Edition (Special)",
  "franchise": "Jujutsu Kaisen",
  "category": "FIGURE",
  "characterName": "Gojo Satoru",
  "price": 109.99,
  "stock": 7,
  "releaseYear": 2024,
  "rating": 5.0
}

> {%
    client.test("Updated successfully with 200", () => {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.price === 109.99, "Expected price to be updated");
    });
%}

### 7. DELETE the product by ID (authorized)
DELETE {{host}}/api/products/{{authCreatedId}}
Authorization: Basic {{username}} {{password}}

> {%
    client.test("Deleted successfully with 204", () => {
        client.assert(response.status === 204, "Expected 204 but got " + response.status);
    });
%}

### 8. GET non-existent product -> 404 Not Found (authorized)
GET {{host}}/api/products/999999
Accept: {{contentType}}
Authorization: Basic {{username}} {{password}}

> {%
    client.test("Expected 404 Not Found", () => {
        client.assert(response.status === 404, "Expected 404 but got " + response.status);
    });
%}

### 9. CREATE invalid product -> 400 Bad Request (authorized, validation demo)
POST {{host}}/api/products
Content-Type: {{contentType}}
Authorization: Basic {{username}} {{password}}

{
  "title": "",
  "franchise": "",
  "category": "FIGURE",
  "price": -10.00,
  "stock": -1
}

> {%
    client.test("Expected 400 Bad Request for validation error", () => {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
    });
%}

### 10. GET products WITHOUT credentials -> 401 Unauthorized (proves Basic Auth protection)
GET {{host}}/api/products
Accept: {{contentType}}

> {%
    client.test("Rejected with 401 Unauthorized", () => {
        client.assert(response.status === 401, "Expected 401 but got " + response.status);
    });
%}
