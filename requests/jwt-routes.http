@host = http://localhost:8080
@contentType = application/json

### 1. AUTH USER: Get JWT token for USER role (200 OK)
POST {{host}}/api/v1/auth/authenticate
Content-Type: {{contentType}}

{
  "email": "john@mail.com",
  "password": "password"
}

> {%
    client.global.set("userToken", response.body.token);
    client.test("1. Obtain JWT token for USER (john@mail.com): 200 OK", () => {
        client.assert(response.status === 200, "Expected 200 OK");
    });
%}

### 2. AUTH ADMIN: Get JWT token for ADMIN role (200 OK)
POST {{host}}/api/v1/auth/authenticate
Content-Type: {{contentType}}

{
  "email": "admin@animestore.com",
  "password": "admin"
}

> {%
    client.global.set("adminToken", response.body.token);
    client.test("2. Obtain JWT token for ADMIN (admin@animestore.com): 200 OK", () => {
        client.assert(response.status === 200, "Expected 200 OK");
    });
%}

### 3. AUTH SUPERADMIN: Get JWT token for SUPERADMIN role (200 OK)
POST {{host}}/api/v1/auth/authenticate
Content-Type: {{contentType}}

{
  "email": "superadmin@animestore.com",
  "password": "superadmin"
}

> {%
    client.global.set("superadminToken", response.body.token);
    client.test("3. Obtain JWT token for SUPERADMIN (superadmin@animestore.com): 200 OK", () => {
        client.assert(response.status === 200, "Expected 200 OK");
    });
%}

### 4. USER JWT: Access /hello/user with Bearer token (200 OK)
GET {{host}}/api/products/hello/user
Authorization: Bearer {{userToken}}
Accept: {{contentType}}

> {%
    client.test("4. USER JWT accesses /hello/user: 200 OK", () => {
        client.assert(response.status === 200, "Expected 200 OK");
    });
%}

### 5. USER JWT: View products list with Bearer token (200 OK)
GET {{host}}/api/products
Authorization: Bearer {{userToken}}
Accept: {{contentType}}

> {%
    client.test("5. USER JWT views products list: 200 OK", () => {
        client.assert(response.status === 200, "Expected 200 OK");
    });
%}

### 6. USER JWT RESTRICTION: Denied from /hello/admin (403 Forbidden)
GET {{host}}/api/products/hello/admin
Authorization: Bearer {{userToken}}
Accept: {{contentType}}

> {%
    client.test("6. USER JWT denied from /hello/admin: 403 Forbidden", () => {
        client.assert(response.status === 403, "Expected 403 Forbidden");
    });
%}

### 7. ADMIN JWT: Access /hello/admin with Bearer token (200 OK)
GET {{host}}/api/products/hello/admin
Authorization: Bearer {{adminToken}}
Accept: {{contentType}}

> {%
    client.test("7. ADMIN JWT accesses /hello/admin: 200 OK", () => {
        client.assert(response.status === 200, "Expected 200 OK");
    });
%}

### 8. ADMIN JWT: Create new product with Bearer token (201 Created)
POST {{host}}/api/products
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "title": "Sung Jinwoo Shadow Monarch Figure",
  "franchise": "Solo Leveling",
  "category": "FIGURE",
  "characterName": "Sung Jinwoo",
  "price": 119.99,
  "stock": 10,
  "releaseYear": 2025,
  "rating": 5.0
}

> {%
    client.global.set("jwtProductId", response.body.id);
    client.test("8. ADMIN JWT creates product: 201 Created", () => {
        client.assert(response.status === 201, "Expected 201 Created");
    });
%}

### 9. ADMIN JWT RESTRICTION: Denied from deleting product (403 Forbidden)
DELETE {{host}}/api/products/{{jwtProductId}}
Authorization: Bearer {{adminToken}}

> {%
    client.test("9. ADMIN JWT denied from deleting product: 403 Forbidden", () => {
        client.assert(response.status === 403, "Expected 403 Forbidden");
    });
%}

### 10. SUPERADMIN JWT: Delete product with Bearer token (204 No Content)
DELETE {{host}}/api/products/{{jwtProductId}}
Authorization: Bearer {{superadminToken}}

> {%
    client.test("10. SUPERADMIN JWT deletes product: 204 No Content", () => {
        client.assert(response.status === 204, "Expected 204 No Content");
    });
%}
